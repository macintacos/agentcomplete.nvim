#!/usr/bin/env bash
#MISE description="Install pinned tools, fetch test deps, register git hooks"

set -euo pipefail

# `mise install` installs every tool in mise.toml; the postinstall hook then
# runs `hk install --mise` to (re)register the git hooks.
mise install

# mini.test ships inside mini.nvim. Clone it into a gitignored deps dir so the
# headless test runtime can find it (see tests/minimal_init.lua).
mini_dir=".tests/site/pack/deps/start/mini.nvim"
if [ -d "$mini_dir/.git" ]; then
  git -C "$mini_dir" pull --ff-only
else
  git clone --filter=blob:none https://github.com/echasnovski/mini.nvim "$mini_dir"
fi
