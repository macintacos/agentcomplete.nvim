#!/usr/bin/env bash
#MISE description="Install pinned tools, fetch test deps, register git hooks"

set -euo pipefail

# `mise install` installs every tool in mise.toml; the postinstall hook then
# runs `hk install --mise` to (re)register the git hooks.
mise install

# git exports GIT_DIR / GIT_WORK_TREE into hook environments (the pre-push hook
# runs this task via `mise run test`). They override the `-C <dir>` targets below,
# redirecting the vendored-dep updates at this repo instead of the clones — which
# aborts the first push of any new branch. Clear them so each `git -C` hits its
# named dir. See EXC-658.
unset GIT_DIR GIT_WORK_TREE

# mini.test ships inside mini.nvim. Clone it into a gitignored deps dir so the
# headless test runtime can find it (see tests/minimal_init.lua).
mini_dir=".tests/site/pack/deps/start/mini.nvim"
if [ -d "$mini_dir/.git" ]; then
  git -C "$mini_dir" pull --ff-only
else
  git clone --filter=blob:none https://github.com/echasnovski/mini.nvim "$mini_dir"
fi

# blink.cmp powers the `mise run diag` headless blink setup. Pinned to a v1 tag on
# purpose: blink v2 hard-requires the compiled `blink.lib` (can't build in CI),
# while v1's `sources` config shape matches what the suppression wrap reads — so it
# validates only-source suppression headlessly. Real user setups on v2 are
# unaffected (the plugin reads the same config fields on both). Not on the test
# runtimepath, so the suite still exercises the blink-absent path.
blink_dir=".tests/site/pack/deps/start/blink.cmp"
blink_tag="v1.10.0"
if [ ! -d "$blink_dir/.git" ]; then
  git clone --filter=blob:none https://github.com/Saghen/blink.cmp "$blink_dir"
fi
git -C "$blink_dir" fetch --tags --quiet origin
git -C "$blink_dir" checkout --quiet "$blink_tag"

# hk's TypeScript(TypeCheck) step runs opencode/node_modules/.bin/tsc; nothing else
# creates it. --frozen-lockfile so a drifted package.json fails here rather than
# silently rewriting the committed lockfile.
bun install --cwd opencode --frozen-lockfile
